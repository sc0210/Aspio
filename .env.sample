# Aspiro Development Environment Configuration
# Copy this file to .env and update the values

# ======================================
# Docker Compose Secrets (referenced by docker-compose.yml)
# ======================================
POSTGRES_USER=aspiro_user
POSTGRES_PASSWORD=aspiro_password
POSTGRES_DB=aspiro_db
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
PGADMIN_EMAIL=admin@aspiro.dev
PGADMIN_PASSWORD=admin123

# Developer-only route: password-less sign-in (/auth/dev-login). DEV_TOOLS_TOKEN
# gates it (sent as X-Dev-Tools-Token); with it empty the route is not even mounted. Leave DEV_LOGIN_ENABLED=false / token empty
# unless you are actively developing — docker-compose.lan.yml re-exposes the ports
# to the network, so do NOT set them when using that overlay.
DEV_LOGIN_ENABLED=false
DEV_TOOLS_TOKEN=

# LAN access (docker-compose.lan.yml only): this machine's LAN IP, e.g. 192.168.1.50
# (Pi/Linux: `hostname -I`; macOS: `ipconfig getifaddr en0`). Never localhost/127.0.0.1.
# LAN_HOST=192.168.1.50

# ======================================
# Database Configuration
# ======================================
# NOTE: the Docker backend does NOT read these — docker-compose.yml builds its own
# DATABASE_URL from POSTGRES_* above and connects to the `postgres` service on 5432
# in-network. These are for native tooling: the Docker Postgres is published on the
# host as 127.0.0.1:5433, while a natively-installed Postgres listens on :5432. Point
# a host-shell `alembic` at 5433 or it silently migrates the wrong database.
DATABASE_URL=postgresql+asyncpg://aspiro_user:aspiro_password@localhost:5432/aspiro_db
DATABASE_URL_SYNC=postgresql://aspiro_user:aspiro_password@localhost:5432/aspiro_db

# Connection Pool Settings (SQLAlchemy)
# Adjust based on your workload and available resources
DATABASE_POOL_SIZE=20          # Base pool size (increase for high concurrency)
DATABASE_MAX_OVERFLOW=30       # Additional connections beyond pool_size
DATABASE_POOL_TIMEOUT=60       # Seconds to wait for connection before timeout
DATABASE_POOL_RECYCLE=3600     # Recycle connections after 1 hour (prevent stale connections)

# ======================================
# Redis — REMOVED
# ======================================
# Aspiro does not use Redis (rate limiting is in-memory, caches are in-process/DB).
# There is no redis service in any compose file; do not add REDIS_* vars.

# ======================================
# JWT Security Configuration
# ======================================
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================================
# OAuth Configuration (Google)
# ======================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must match NEXTAUTH_URL below: {NEXTAUTH_URL}/api/auth/callback/google
# Also register this URI in Google Cloud Console → APIs & Services → Credentials
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ======================================
# Application Configuration
# ======================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ======================================
# CORS Configuration
# ======================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]

# ======================================
# File Upload Configuration
# ======================================
UPLOAD_DIRECTORY=/app/uploads
MAX_FILE_SIZE_MB=10  # attachment size limit, in MB

# ======================================
# Rate Limiting Configuration
# ======================================
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60  # seconds

# ======================================
# External API Configuration
# ======================================
CURRENCY_API_KEY=your-currency-api-key
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest

# ======================================
# Market Data APIs Configuration
# ======================================
# Yahoo Finance (no API key required, but rate limited)
NEXT_PUBLIC_YAHOO_FINANCE_ENABLED=true
NEXT_PUBLIC_YAHOO_FINANCE_RATE_LIMIT=2000

# TradingView Configuration
# Note: TradingView doesn't have a public REST API
# You may need to use WebSocket connections or third-party proxies
NEXT_PUBLIC_TRADINGVIEW_WEBSOCKET_URL=wss://data.tradingview.com/socket.io/
NEXT_PUBLIC_ENABLE_REAL_TRADINGVIEW=false

# Finnhub API (alternative for US market data)
NEXT_PUBLIC_FINNHUB_API_KEY=your_finnhub_api_key_here
NEXT_PUBLIC_FINNHUB_ENABLED=false

# Binance API (for crypto data)
NEXT_PUBLIC_BINANCE_API_KEY=your_binance_api_key_here
NEXT_PUBLIC_BINANCE_SECRET_KEY=your_binance_secret_key_here

# Asia-Pacific Market Data APIs
NEXT_PUBLIC_FINLAB_API_KEY=your_finlab_api_key_here          # Taiwan market
NEXT_PUBLIC_SGX_API_KEY=your_sgx_api_key_here                # Singapore market
NEXT_PUBLIC_HKX_API_KEY=your_hkx_api_key_here                # Hong Kong market
NEXT_PUBLIC_TSE_API_KEY=your_tse_api_key_here                # Tokyo market

# ======================================
# Market Data Configuration
# ======================================
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_ENABLE_MOCK_DATA=true
NEXT_PUBLIC_DEFAULT_MARKET_DATA_TTL=60                       # Cache TTL in minutes
NEXT_PUBLIC_ENABLE_HISTORICAL_DATA=true
NEXT_PUBLIC_MAX_HISTORICAL_DAYS=365

# ======================================
# Email Configuration (for notifications)
# ======================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@aspiro.com
SMTP_FROM_NAME=Aspiro Finance

# ======================================
# NextAuth Configuration (Frontend)
# ======================================
# PRODUCTION: set to your public domain, e.g. https://aspiro.yourdomain.com
# This value drives the Google OAuth redirect_uri — mismatch causes 400 errors.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-change-in-production

# ======================================
# Frontend API Configuration
# ======================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ======================================
# Feature Flags
# ======================================
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_OCR=true
NEXT_PUBLIC_ENABLE_QR_PAYMENTS=true
NEXT_PUBLIC_ENABLE_SOCIAL_FEATURES=true

# ======================================
# Development Tools Configuration
# ======================================
# pgAdmin — docker-compose.yml reads PGADMIN_EMAIL / PGADMIN_PASSWORD (top of this
# file) and passes them to the container as PGADMIN_DEFAULT_*; setting the DEFAULT_
# names here would be ignored by compose.
# (Redis Commander removed — no Redis in this project.)

# ======================================
# Production Security (Change these in production!)
# ======================================
# Generate strong secrets using: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET_KEY=
# NEXTAUTH_SECRET=
# DATABASE_PASSWORD=
# REDIS_PASSWORD=

# ======================================
# Asian Market Specific Configuration
# ======================================
DEFAULT_CURRENCY=SGD
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=Asia/Singapore

# Regional API Keys (if needed)
PAYNOW_API_KEY=your-paynow-api-key
GRABPAY_API_KEY=your-grabpay-api-key
SHOPEEPAY_API_KEY=your-shopeepay-api-key

# ======================================
# Monitoring and Analytics (Optional)
# ======================================
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=your-ga-id
MIXPANEL_TOKEN=your-mixpanel-token

# ======================================
# Development Mode Settings
# ======================================
# Set to true for additional debugging and development features
DEV_MODE=true
API_DOCS_ENABLED=true
ALLOW_CORS_ALL_ORIGINS=false

# ======================================
# LINE Bot Configuration
# ======================================
# Get from https://developers.line.biz/console/ → your channel → Basic settings / Messaging API
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# URL embedded in /link messages sent to LINE users.
# Local testing (same machine):  http://localhost:3000
# Mobile testing:                set to your cloudflared frontend tunnel URL
# Production:                    https://<APP_DOMAIN> (set from APP_DOMAIN in
#                                docker-compose.pi.yml, so this value is local-only)
FRONTEND_URL=http://localhost:3000

# ======================================
# External access (LINE webhook)
# ======================================
# There is no ngrok compose overlay. For a public HTTPS URL locally, the base
# docker-compose.yml already runs a `cloudflared` container; read the generated URL with:
#   docker logs aspiro-cloudflared 2>&1 | grep trycloudflare
# CORS: base compose has CORS_ALLOW_NGROK (off by default). To trust a specific tunnel
# origin instead, list it in EXTRA_CORS_ORIGINS rather than turning that on.