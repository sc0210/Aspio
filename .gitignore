# Next.js build output
.next
out

# Generated by next dev / next build, and its contents differ between the two:
# dev writes `./.next/dev/types/routes.d.ts`, build writes `./.next/types/routes.d.ts`.
# Tracking it means the file flips back and forth and shows up dirty depending on
# which command ran last. Nothing needs it in the repo — `tsc --noEmit` passes
# without it (the routes.d.ts it points at lives under the ignored .next/ anyway),
# and both `next dev` and `next build` recreate it.
frontend/next-env.d.ts

