# ─── TEMPLATE — copy to backend/.env for local development ───────────────────
# A self-hosted instance is configured by `scripts/aspiro setup` instead
# (see production.env.sample and docs/SELF_HOSTING.md).

# Application
APP_NAME=Aspiro API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=local

# Interactive API docs at /docs, /redoc, /openapi.json. Off unless set: DEBUG and
# ENVIRONMENT are not safe gates here — every stack built from docker-compose.yml
# reports DEBUG=true, including internet-facing self-hosted ones.
ENABLE_API_DOCS=true

# Database — backend runtime connection
# Local:    postgresql+asyncpg://aspiro_user:aspiro_password@localhost:5433/aspiro_db
# Supabase: postgresql+asyncpg://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres?ssl=require
#
# IMPORTANT (Supabase): the runtime URL MUST use the TRANSACTION pooler on port :6543.
# Do NOT use the session-mode pooler (the same pooler.supabase.com host on :5432) —
# session mode caps TOTAL clients at the pooler's pool size (often 15), so the app
# throws asyncpg EMAXCONNSESSION 500s under any concurrency. :6543 has no such cap and
# is the mode meant for apps that run their own SQLAlchemy pool (we set
# statement_cache_size=0, which makes the transaction pooler safe).
DATABASE_URL=postgresql+asyncpg://aspiro_user:aspiro_password@localhost:5433/aspiro_db
# Max connections per replica = DATABASE_POOL_SIZE + DATABASE_MAX_OVERFLOW (10 here).
# On :6543 this is comfortable. If you are ever forced onto the session pooler, this
# budget — times the replica count, plus Alembic/admin connections — must stay UNDER
# the pooler's pool size, so lower these further.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
# Set true only to force a fresh connection per request (rarely needed). Leave false so
# connections are reused through the pooler instead of re-handshaking every request.
DATABASE_USE_NULLPOOL=false
DATABASE_ECHO_SQL=false

# Security
# Generate with: openssl rand -hex 32 (placeholders are refused at startup unless ALLOW_INSECURE_DEFAULTS=true)
SECRET_KEY=your-secret-key-here-change-in-production
# UPLOAD_PATH=./uploads/transactions
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# LINE Bot (Messaging API channel)
# Get these from https://developers.line.biz/console/ → your channel → Basic settings / Messaging API
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
# LINE Login channel + LIFF app (for the in-LINE web UI). Create a LINE Login
# channel under the same provider, add a LIFF app, then fill these in.
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LIFF_ID=your-liff-id

# External APIs
EXCHANGE_RATES_API_KEY=your-api-key

# CORS
CORS_ORIGINS=["http://localhost:3000", "https://your-app.vercel.app"]
# Trust any *.ngrok.io / *.ngrok-free.app origin with credentials. Anyone can
# register an ngrok subdomain, so leave this off and prefer listing the exact
# tunnel URL in EXTRA_CORS_ORIGINS; turn it on only while actively tunnelling.
CORS_ALLOW_NGROK=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
# Multiplies the strict per-endpoint auth limits (login 5/min, register 3/min).
# Set 10 for local development, where React strict mode double-invokes effects.
# Leave at 1 anywhere real users sign in — it is a password-guessing budget.
RATE_LIMIT_DEV_MULTIPLIER=1

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@aspiro.com

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# File upload
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=["image/jpeg", "image/png", "image/webp"]

# Local-dev only: allow placeholder SECRET_KEY / DB password. Never set in production.
# ALLOW_INSECURE_DEFAULTS=false

# Admin users, created or updated at startup. Format: "email1:role1,email2:role2"
# Roles: super_admin, admin, moderator, analyst, support. `aspiro admin grant` is the usual way.
# ADMIN_EMAILS=admin@example.com:super_admin

# Required by /health/detailed (send it as the X-Health-Key header).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# HEALTH_CHECK_KEY=
