# ─── PRODUCTION (Supabase + Remote Hosting) ──────────────────────────────────
# Usage: cp backend/config/env.production.sample backend/.env.production
#        OR set these as environment variables in your hosting provider.
# The app auto-loads .env.production when ENVIRONMENT=production.

# Application
APP_NAME=Aspiro API
DEBUG=false
ENVIRONMENT=production

# IMPORTANT: Set to true in production — schema is managed by Alembic, not create_all.
# Without this, every startup runs create_all against the DB, adding ~6s latency.
SKIP_DB_SCHEMA_INIT=true

# ── Supabase PostgreSQL ──────────────────────────────────────────────────────
# Find in: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "URI" tab and select "Transaction" mode (port 6543) for connection pooling,
# or "Session" mode (port 5432) if you need prepared statements / long-lived connections.
#
# Transaction mode (recommended for serverless / short-lived connections):
#   DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?ssl=require
#
# Session mode (for long-running processes):
#   DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?ssl=require
#
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?ssl=require

# Pool — NOTE: when using Transaction mode (port 6543), the app uses NullPool and
# these pool settings are ignored (Supabase's PgBouncer manages the pool).
# They only apply when using Session mode (port 5432).
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=60
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO_SQL=false

# Security — generate with: python -m secrets token_hex 32  (minimum 32 chars)
SECRET_KEY=your-production-secret-key-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth — register https://your-backend-domain.com as authorised origin
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-frontend-domain.vercel.app/api/auth/callback/google

# External APIs
EXCHANGE_RATES_API_KEY=your-api-key

# CORS — must include your Vercel frontend URL
CORS_ORIGINS=["https://your-app.vercel.app"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Health check — required by /health/detailed endpoint for monitoring systems
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
HEALTH_CHECK_KEY=your-health-check-key

# Frontend URL — used to build email links (verify, reset)
FRONTEND_URL=https://your-app.vercel.app

# Admin users — format: "email1:role1,email2:role2"
# Roles: super_admin, admin, support, viewer
# e.g. ADMIN_EMAILS=admin@example.com:super_admin
ADMIN_EMAILS=

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@aspiro.app
