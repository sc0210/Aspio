# ─── LOCAL DEVELOPMENT ───────────────────────────────────────────────────────
# Usage: cp backend/config/env.local.sample backend/.env.local
# The app auto-loads .env.local when ENVIRONMENT=local or development.

# Application
APP_NAME=Aspiro API
DEBUG=true
ENVIRONMENT=local

# Database — local PostgreSQL (docker-compose exposes port 5433)
DATABASE_URL=postgresql+asyncpg://aspiro_user:aspiro_password@localhost:5433/aspiro_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO_SQL=false

# Security
SECRET_KEY=generate-with--python-m-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (optional for local — needed for SSO testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# External APIs (optional)
EXCHANGE_RATES_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=200
RATE_LIMIT_BURST=50

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text
