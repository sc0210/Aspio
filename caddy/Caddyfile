{
	# Whose X-Forwarded-For to believe.
	#
	# The backend reads the client's address from the end of that header
	# (TRUSTED_PROXY_COUNT), which is only safe if the header cannot be written by
	# the client. Caddy still listens on the LAN, so without this any device on the
	# home WiFi could connect directly and present a forged two-hop chain, and the
	# rate limiter would bucket a login brute-force under whatever address it was
	# handed. Docker's own ranges cover cloudflared, the only hop that legitimately
	# sits in front; 192.168.x LAN clients are deliberately not trusted.
	servers {
		trusted_proxies static 172.16.0.0/12
	}
}

# HTTPS entrypoint for the custom Caddy build (CADDY_IMAGE unset). APP_DOMAIN and
# CF_API_TOKEN come from the environment (docker-compose.pi.yml requires APP_DOMAIN).
# Tunnel-only hosts use Caddyfile.http instead.
#
# LAN access (direct, fast): <APP_DOMAIN> → this Caddy over real HTTPS.
{$APP_DOMAIN} {
	# Automatic HTTPS via Let's Encrypt, DNS-01 challenge through Cloudflare.
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# The backend's own cap (BodySizeLimitMiddleware: MAX_FILE_SIZE_MB, 10, plus 1 MiB
	# of multipart framing), enforced here too so an oversized body is refused with a
	# 413 before it is streamed through to the backend. Raise both together.
	request_body {
		max_size 11MiB
	}

	# Only NextAuth may call this, and it reaches the backend directly over the
	# Docker network (INTERNAL_API_URL), never through Caddy. Refusing it here keeps
	# the account-login endpoint off the internet even if a backend check regresses.
	# Caddy runs the most specific handle first, so this wins over /api/v1/*.
	handle /api/v1/auth/google/callback* {
		respond 404
	}

	# Backend API (FastAPI) lives under /api/v1
	handle /api/v1/* {
		reverse_proxy backend:8000 {
			# Below uvicorn's --timeout-keep-alive 30 (docker-compose.pi.yml), so Caddy
			# never sends a request down a connection the backend is closing.
			transport http {
				keepalive 20s
			}
		}
	}

	# Everything else — including NextAuth's /api/auth/* — goes to the Next.js app
	handle {
		reverse_proxy frontend:3000
	}
}

# Cloudflare Tunnel origin (for LINE webhook + remote reach).
#
# The edge terminates TLS and cloudflared reaches this over the Docker network, so
# this block is plain HTTP. It must be declared explicitly: without it Caddy adds
# its automatic HTTP→HTTPS redirect for this hostname, and a request arriving from
# the tunnel would be bounced back to https://<domain> — through the edge, into the
# tunnel, and round again.
#
# The HTTPS block above still serves the LAN directly, so both paths work.
http://{$APP_DOMAIN} {
	# The backend's body cap; see the HTTPS block above.
	request_body {
		max_size 11MiB
	}
	# NextAuth-only: see the same handle above.
	handle /api/v1/auth/google/callback* {
		respond 404
	}
	handle /api/v1/* {
		reverse_proxy backend:8000 {
			# Below uvicorn's --timeout-keep-alive 30 (docker-compose.pi.yml), so Caddy
			# never sends a request down a connection the backend is closing.
			transport http {
				keepalive 20s
			}
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
}
