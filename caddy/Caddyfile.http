{
	# Tunnel-only and Tailscale deployments (CADDY_IMAGE / CADDYFILE / CADDY_BIND in
	# .env). Cloudflare's edge or the tailscale container terminates TLS and forwards
	# plain HTTP to this origin, so there is no certificate to obtain and no Cloudflare
	# DNS plugin needed: this file parses on the stock caddy:2-alpine image. auto_https off also stops Caddy adding an
	# HTTP->HTTPS redirect, which would loop back through the edge.
	auto_https off

	# Whose X-Forwarded-For to believe — see the same block in caddy/Caddyfile.
	# Docker's ranges cover cloudflared and tailscale (containers on this network, or a
	# host service reaching the published port via the bridge gateway).
	servers {
		trusted_proxies static 172.16.0.0/12
	}
}

# Any Host: the tunnel's public hostname or the Tailscale node decides what reaches
# this, so the origin need not repeat the domain. Same routing as caddy/Caddyfile: the backend under
# /api/v1 (which the frontend calls same-origin), everything else — including
# NextAuth's /api/auth/* — to Next.js.
:80 {
	# The backend's own cap (BodySizeLimitMiddleware: MAX_FILE_SIZE_MB, 10, plus 1 MiB
	# of multipart framing), enforced here too so an oversized body is refused with a
	# 413 before it is streamed through to the backend. Raise both together.
	request_body {
		max_size 11MiB
	}

	# Only NextAuth may call this, and it reaches the backend directly over the
	# Docker network (INTERNAL_API_URL), never through Caddy. Refusing it here keeps
	# the account-login endpoint off the internet even if a backend check regresses.
	# Caddy runs the most specific handle first, so this wins over /api/v1/*.
	handle /api/v1/auth/google/callback* {
		respond 404
	}

	handle /api/v1/* {
		reverse_proxy backend:8000 {
			# Below uvicorn's --timeout-keep-alive 30 (docker-compose.pi.yml), so Caddy
			# never sends a request down a connection the backend is closing.
			transport http {
				keepalive 20s
			}
		}
	}
	handle {
		reverse_proxy frontend:3000
	}
}
