# production.env.sample — every variable docker-compose.pi.yml (the production stack) reads.
#
#   cp production.env.sample .env   then fill in the Required section,
#   or run: scripts/aspiro setup
#
# Placeholders only; never commit a filled-in copy. (For the local dev stack,
# docker-compose.yml, see .env.sample instead.)
#
# Compose refuses to start the production stack while any REQUIRED secret is unset
# or empty ("required variable ... is missing a value"), and the backend refuses to
# start on a placeholder SECRET_KEY or the database password `aspiro_password`.
#
# Quoting: compose takes values literally — no surrounding quotes, no trailing
# `# comments` on a value line.

# =============================================================================
# REQUIRED
# =============================================================================

# Postgres password. Also embedded in the backend's DATABASE_URL, so use URL-safe
# characters only — hex is simplest:
#   openssl rand -hex 24
# Takes effect only when the postgres_data volume is first created. On an EXISTING
# database it must equal the password the database already has; to change it, run
# ALTER USER first (docker exec aspiro-postgres psql -U <user> -d <db> -c
# "ALTER USER <user> PASSWORD '<new>'") and then update this line.
POSTGRES_PASSWORD=

# Backend JWT signing key. Changing it signs every user out.
#   openssl rand -hex 32
SECRET_KEY=

# NextAuth session encryption key (frontend). Changing it signs every user out.
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Public hostname the app is served on (no scheme). Drives NEXTAUTH_URL,
# CORS_ORIGINS, FRONTEND_URL and the Google OAuth redirect URI.
APP_DOMAIN=aspiro.example.com

# =============================================================================
# OPTIONAL — features
# =============================================================================

# Google sign-in. Without these, only email/password login works. Register
# https://<APP_DOMAIN>/api/auth/callback/google as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE bot (https://developers.line.biz/console/). Webhook URL:
# https://<APP_DOMAIN>/api/v1/line-bot/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# FinLab (https://ai.finlab.tw/) whole-market Taiwan prices. Without a token, Taiwan
# symbols use Yahoo Finance. Setting one also adds FinLab (~300MB with pyarrow and
# scipy) to the backend image on the next `aspiro update`.
FINLAB_API_TOKEN=

# Admins granted at every backend start, as email:role pairs (roles: super_admin,
# admin, moderator, analyst, support). The usual way is instead a one-off
# `aspiro admin grant you@example.com` after you register. Only use this list on a
# private (e.g. tailnet-only) instance: on a public one, whoever registers a listed
# email first is made admin on the next restart.
# ADMIN_EMAILS=you@example.com:super_admin

# =============================================================================
# OPTIONAL — ingress
# =============================================================================

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel). With it,
# COMPOSE_PROFILES=tunnel starts cloudflared as a container (`aspiro setup` sets the
# profile itself when given a token). Leave both empty if cloudflared
# runs on the host. Point the tunnel's public hostname at http://caddy:80.
CF_TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel

# Tailscale, instead of or beside the tunnel (docs/SELF_HOSTING.md, section 2b).
# An auth key from the admin console (Settings → Keys) plus COMPOSE_PROFILES=tailscale
# starts the tailscale container; `aspiro setup --tailscale-authkey` sets all of these.
# APP_DOMAIN is then <TS_HOSTNAME>.<tailnet>.ts.net. TS_SERVE_FILE picks
# tailscale/serve.json (your tailnet only) or tailscale/funnel.json (public via Funnel,
# needed for the LINE webhook).
# TS_AUTHKEY=
# TS_HOSTNAME=aspiro
# TS_SERVE_FILE=serve.json
# COMPOSE_PROFILES=tailscale

# Tunnel-only and Tailscale hosts: run stock Caddy on plain HTTP :80 instead of the
# custom Cloudflare-DNS build (which releases do not ship), published on loopback only so
# the unencrypted origin is reachable by cloudflared or tailscale and nothing else. Set all
# three; leave all three unset for the LAN-HTTPS setup the original Pi uses.
CADDY_IMAGE=caddy:2-alpine
CADDYFILE=Caddyfile.http
CADDY_BIND=127.0.0.1

# Only for the custom Caddy (CADDY_IMAGE unset): Cloudflare API token
# (Zone → DNS → Edit) used to obtain a Let's Encrypt certificate by DNS-01 for LAN
# HTTPS on :443. It may instead live in caddy/cf.vars (git-ignored), which
# `scripts/aspiro` passes to compose after .env.
# CF_API_TOKEN=

# =============================================================================
# OPTIONAL — tuning (defaults shown)
# =============================================================================

# POSTGRES_USER=aspiro_user
# POSTGRES_DB=aspiro_db
# LOG_LEVEL=INFO

# Proxies in front of the backend that append to X-Forwarded-For
# (cloudflared or tailscale → caddy = 2). Wrong values let clients spoof their
# rate-limit bucket.
# TRUSTED_PROXY_COUNT=2

# Build-time API base for the browser bundle. Empty = same-origin /api/v1 (Caddy
# routes it to the backend). Set only for an API on another origin, then rebuild
# the frontend.
# NEXT_PUBLIC_API_URL=

# Commit reported by /health; scripts/aspiro exports it.
# GIT_SHA=unknown

# =============================================================================
# LOCAL DEV ONLY — never in production
# =============================================================================

# Lets the backend start on placeholder secrets / the default DB password.
# docker-compose.yml (local dev) defaults it to true; docker-compose.pi.yml does
# not pass it to the backend at all, so setting it here has no effect on the
# production stack — by design.
# ALLOW_INSECURE_DEFAULTS=false
