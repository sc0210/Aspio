# ─── TEMPLATE — copy to frontend/.env.local for local development ────────────
# A self-hosted instance is configured by `scripts/aspiro setup` instead.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth (optional — needed for SSO)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Backend API
# Local:   http://localhost:8000/api/v1
# Prod:    https://your-backend-domain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# LIFF app ID for the in-LINE web UI (/liff route). From the LINE Login channel's LIFF app.
NEXT_PUBLIC_LIFF_ID=your-liff-id
# Used by Next.js server-side routes to reach backend (can differ inside Docker)
INTERNAL_API_URL=http://localhost:8000/api/v1

# Demo account (server-side only — never use NEXT_PUBLIC_ prefix)
DEMO_EMAIL=demo@aspiro.dev
DEMO_PASSWORD=

# Environment
NODE_ENV=development

# Debug / Logging
NEXT_PUBLIC_DEBUG_LOGS=false
NEXT_PUBLIC_COMPACT_LOGS=true
NEXT_PUBLIC_LOG_MODULES=auth,api,session

# Analytics (optional — off unless enabled; see src/lib/analytics/config.ts)
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io
# NEXT_PUBLIC_MIXPANEL_TOKEN=
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=
