# ─── LOCAL DEVELOPMENT ───────────────────────────────────────────────────────
# Usage: cp frontend/config/env.local.sample frontend/.env.local
# Next.js automatically loads .env.local in development.

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with--openssl-rand-base64-32

# Google OAuth (optional — needed for SSO testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend API (FastAPI running locally)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Used by Next.js server-side routes to reach the backend inside Docker network
INTERNAL_API_URL=http://localhost:8000/api/v1

# Environment
NODE_ENV=development

# Debug / Logging
NEXT_PUBLIC_DEBUG_LOGS=true
NEXT_PUBLIC_COMPACT_LOGS=true
NEXT_PUBLIC_LOG_MODULES=auth,api,session
