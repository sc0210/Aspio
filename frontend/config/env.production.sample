# ─── PRODUCTION (Vercel) ─────────────────────────────────────────────────────
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables
# Do NOT commit this file with real values.
#
# After setting variables in Vercel, trigger a redeploy for them to take effect.

# NextAuth
# NEXTAUTH_URL must be your production Vercel URL (no trailing slash)
NEXTAUTH_URL=https://your-app.vercel.app
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-production-nextauth-secret

# Google OAuth
# Authorised redirect URI in Google Console:
#   https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Backend API — URL of your deployed FastAPI backend (the Pi, or a cloud host)
# Must be HTTPS in production
NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api/v1
# Server-side internal URL (can be the same as NEXT_PUBLIC_API_URL on Vercel)
INTERNAL_API_URL=https://your-backend-domain.com/api/v1

# Environment
NODE_ENV=production

# Debug / Logging — disable in production
NEXT_PUBLIC_DEBUG_LOGS=false
NEXT_PUBLIC_COMPACT_LOGS=true
NEXT_PUBLIC_LOG_MODULES=
