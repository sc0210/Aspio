# Analytics Environment Variables Configuration
# Copy this to .env.local and configure as needed

# ============================================
# REPORTS CONFIGURATION
# ============================================

# Use mock data for reports (set to true until backend endpoints are implemented)
# This prevents 404 errors in console during development
NEXT_PUBLIC_REPORTS_USE_MOCK=true

# Set to true when backend report endpoints are ready
# NEXT_PUBLIC_REPORTS_BACKEND_READY=false

# ============================================
# ANALYTICS CONFIGURATION
# ============================================

# Enable/disable analytics globally
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# ============================================
# ANALYTICS PROVIDERS (Choose one or more)
# ============================================

# Option 1: Plausible Analytics (Recommended for Privacy)
# Free tier: 10k pageviews/month
# Privacy-focused, GDPR compliant, no cookies
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io  # Optional, for self-hosted

# Option 2: Mixpanel (Advanced Analytics)
# Free tier: 100k events/month
# Advanced event tracking, funnels, cohorts
# NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here

# Option 3: Custom Events Endpoint
# Send events to your own backend
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://your-api.com/api/analytics/events

# ============================================
# PRIVACY SETTINGS
# ============================================

# Respect browser's "Do Not Track" setting
# NEXT_PUBLIC_ANALYTICS_RESPECT_DNT=true

# Anonymize IP addresses
# NEXT_PUBLIC_ANALYTICS_ANONYMIZE_IPS=true

# Require cookie consent before tracking
# NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=true

# Data retention days (optional)
# NEXT_PUBLIC_ANALYTICS_RETENTION_DAYS=365

# ============================================
# SAMPLING (Optional - for high traffic sites)
# ============================================

# Enable event sampling to reduce volume
# NEXT_PUBLIC_ANALYTICS_SAMPLING_ENABLED=false

# Sample rate (0.0 to 1.0, e.g., 0.5 = 50% of events)
# NEXT_PUBLIC_ANALYTICS_SAMPLING_RATE=1.0

# ============================================
# DEVELOPMENT SETTINGS
# ============================================

# Enable debug logging in console (auto-enabled in development)
# NEXT_PUBLIC_ANALYTICS_DEBUG=true

# ============================================
# EXAMPLE CONFIGURATIONS
# ============================================

# For Production (Privacy-First with Plausible):
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=aspiro.yourdomain.com

# For Development (All features):
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_MIXPANEL_TOKEN=dev_token_12345
# NEXT_PUBLIC_ANALYTICS_DEBUG=true

# For Compliance Testing (Maximum Privacy):
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=test.aspiro.com
# NEXT_PUBLIC_ANALYTICS_RESPECT_DNT=true
# NEXT_PUBLIC_ANALYTICS_ANONYMIZE_IPS=true
# NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=true
