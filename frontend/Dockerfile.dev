# Development Dockerfile for Frontend
FROM node:22-alpine

# Set working directory
WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install all dependencies (including dev dependencies)
RUN npm install

# Add node_modules/.bin to PATH
ENV PATH="/app/node_modules/.bin:$PATH"

# Performance optimizations for development
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start development server with proper host binding for Docker.
# --webpack: Next 16 defaults `next dev` to Turbopack, but the project has a
# custom webpack config (no turbopack config), which is a fatal error under
# Turbopack. Matches the package.json "dev" script.
CMD ["npx", "next", "dev", "--hostname", "0.0.0.0", "--webpack"]