{
  "name": "aspiro-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-docker-conflict.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:prod": "NODE_ENV=production next build --webpack",
    "start": "next start",
    "start:prod": "NODE_ENV=production next start",
    "test:prod": "npm run build:prod && npm run start:prod",
    "verify:prod": "node scripts/verify-prod-build.js",
    "build:verify": "npm run build:prod && npm run verify:prod",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "type-check:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "analyze": "ANALYZE=true npm run build",
    "analyze:bundle": "npx @next/bundle-analyzer",
    "analyze:size": "npm run build && npx bundlesize",
    "check:budget": "npm run build && node scripts/check-performance-budget.js",
    "clean": "rm -rf .next out dist",
    "predev:https": "node scripts/check-docker-conflict.mjs",
    "dev:https": "next dev --experimental-https --webpack",
    "export": "next export",
    "prebuild": "echo 'Skipping type check for now'",
    "perf:audit": "lighthouse http://localhost:3000 --output=html --output-path=./performance-audit.html",
    "perf:build": "npm run build && npm run analyze",
    "perf:test": "npm run build && npm run start & sleep 5 && npm run perf:audit && pkill -f 'next start'",
    "test:playwright": "playwright test",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug",
    "test:playwright:ui": "playwright test --ui",
    "test:crud": "playwright test crud/",
    "test:api": "playwright test api/",
    "test:e2e": "playwright test e2e/",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:accessibility": "playwright test accessibility/",
    "test:responsive": "playwright test responsive/",
    "test:ci": "playwright test --reporter=html,junit,json",
    "test:update-snapshots": "playwright test --update-snapshots",
    "test:all": "npm run test:playwright && npm run test",
    "test:install": "playwright install"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.0.18",
    "@hookform/resolvers": "^3.3.0",
    "@line/liff": "^2.31.2",
    "@playwright/test": "^1.64.0",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.0.0",
    "date-fns": "^4.4.0",
    "i18next": "^25.10.10",
    "i18next-resources-to-backend": "^1.2.3",
    "next": "^16.3.8",
    "next-auth": "^4.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.89.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^15.7.3",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.1",
    "web-vitals": "^6.2.3",
    "yup": "^1.3.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "axe-playwright": "^2.2.2",
    "braces": "file:./vendor/braces",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "glob": "^11.0.0",
    "postcss": "$postcss",
    "postcss-selector-parser": "^7.1.6",
    "uuid": "^14.0.0",
    "js-yaml": "^4.3.2",
    "sharp": "^0.35.5",
    "browserslist": "^4.28.9",
    "braces": "$braces"
  }
}
